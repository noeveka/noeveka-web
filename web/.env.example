# ─── SANITY CMS CONFIGURATION ──────────────────────────────────────────────────
VITE_SANITY_PROJECT_ID=gv2yfhf78hj
VITE_SANITY_DATASET=production # 'production' or 'staging'
VITE_SANITY_API_VERSION=2026-01-01

# ─── RESEND & EMAIL CONFIGURATION (Server-side / Edge / Vercel / Cloudflare) ──
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where notification emails for new contact inquiries and downloads should be sent
CONTACT_INBOX_EMAIL=team@noeveka.com

# From sender address (use verified domain in production, or onboarding@resend.dev for testing)
FROM_EMAIL=Noeveka <onboarding@resend.dev>

# Optional: Resend Audience / Marketing List ID to automatically store download leads
# RESEND_AUDIENCE_ID=your_audience_id
